# Rename this file to deno.yml and configure Secrets to enable CI/CD:
# - DENO_DEPLOY_TOKEN

name: Deploy to Deno Deploy

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 9

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'pnpm'

      - run: pnpm install --frozen-lockfile
      - run: pnpm run build

      - name: Deploy to Deno Deploy
        uses: denoland/deployctl@v1
        with:
          project: googleotp2other
          entrypoint: server.ts
